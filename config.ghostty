font-family = "UDEV Gothic 35 JPDOC"
font-family = "UDEV Gothic JPDOC"
font-family = Ricty
font-family = Menlo
font-family = monospace
font-size = 16
adjust-cell-height = 20%

window-padding-x = 14
window-padding-y = 12

cursor-style = block
cursor-style-blink = false
cursor-color = #dcdcdc
cursor-opacity = 0.8
cursor-text = #000000
shell-integration-features = no-cursor

selection-background = #5e6166
selection-foreground = cell-foreground

bell-features = system
